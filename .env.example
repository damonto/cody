# Copy to .env for native Node. Generate the key with: openssl rand -base64 32
CONFIG_ENCRYPTION_KEY=
DATABASE_URL=sqlite:./data/cody.sqlite
# For Node or Vercel: postgres://user:password@host:5432/cody?sslmode=require
# Node migrates automatically at startup; Vercel migrates automatically during deployment.
# Optional separate database connection/role for Vercel migrations and the migration CLI:
# DATABASE_MIGRATION_URL=postgres://migration-user:password@host:5432/cody?sslmode=require
# Native Node only: DATABASE_MIGRATE=false disables automatic startup migrations.
# DATABASE_POOL_SIZE=5
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=cody
HOST=127.0.0.1
PORT=8787
# Local mode is accepted only by a Node server bound to loopback.
# Production console: oidc (set issuer, client ID and allowed emails below).
# Programmatic administration: token (set ADMIN_TOKEN to at least 16 characters).
ADMIN_AUTH_MODE=local
ADMIN_ASSETS_PUBLIC=true
# ADMIN_OIDC_ISSUER=https://identity.example.com
# ADMIN_OIDC_CLIENT_ID=cody
# ADMIN_OIDC_CLIENT_SECRET=
# ADMIN_OIDC_ALLOWED_EMAILS=admin@example.com
# ADMIN_TOKEN=
# Required on Vercel. At least 16 characters; authenticates /_cody/maintenance.
# CRON_SECRET=
