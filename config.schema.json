{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cody Gateway Configuration",
  "$id": "https://example.invalid/cody.schema.json",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "proxy_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "strategy": {
            "type": "string",
            "enum": ["random", "sticky", "priority"]
          },
          "proxies": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "maxLength": 2048,
                  "pattern": "^socks5:\\/\\/"
                },
                "username": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                },
                "password": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                },
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[A-Za-z0-9._-]+$"
                },
                "priority": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "disabled": { "type": "boolean" }
              },
              "required": ["url", "id", "priority", "disabled"],
              "additionalProperties": false,
              "description": "SOCKS5 proxy with remote DNS. Credentials are optional and must be supplied together.",
              "anyOf": [
                { "required": ["username", "password"] },
                {
                  "not": {
                    "anyOf": [
                      { "required": ["username"] },
                      { "required": ["password"] }
                    ]
                  }
                }
              ]
            }
          }
        },
        "required": ["id", "strategy", "proxies"],
        "additionalProperties": false
      }
    },
    "providers": {
      "minItems": 1,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": { "type": "string", "const": "ai_gateway" },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Za-z0-9._-]+$"
              },
              "base_url": { "type": "string", "pattern": "^https?:\\/\\/" },
              "proxy_group": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256,
                    "pattern": "^[A-Za-z0-9._-]+$"
                  },
                  { "type": "null" }
                ]
              },
              "credentials": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "pattern": "^[A-Za-z0-9._-]+$"
                    },
                    "auth": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "type": { "type": "string", "const": "api_key" },
                            "api_key": { "type": "string", "minLength": 1 }
                          },
                          "required": ["type", "api_key"],
                          "additionalProperties": false
                        }
                      ]
                    },
                    "priority": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "disabled": { "type": "boolean" },
                    "proxy_group": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256,
                          "pattern": "^[A-Za-z0-9._-]+$"
                        },
                        { "type": "null" }
                      ]
                    }
                  },
                  "required": ["id", "auth", "priority", "disabled"],
                  "additionalProperties": false
                }
              },
              "models": {
                "minItems": 1,
                "type": "array",
                "items": { "type": "string", "minLength": 1, "maxLength": 256 },
                "uniqueItems": true
              },
              "disabled": { "type": "boolean" },
              "priority": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "supports_websocket": { "default": false, "type": "boolean" },
              "supports_web_search": { "default": false, "type": "boolean" },
              "supports_context_management": {
                "default": false,
                "type": "boolean"
              },
              "retry": {
                "type": "object",
                "properties": {
                  "status_codes": {
                    "maxItems": 20,
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 400,
                      "maximum": 599
                    },
                    "uniqueItems": true
                  },
                  "delays_ms": {
                    "maxItems": 10,
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 60000
                    }
                  }
                },
                "required": ["status_codes", "delays_ms"],
                "additionalProperties": false,
                "anyOf": [
                  {
                    "properties": {
                      "status_codes": { "maxItems": 0 },
                      "delays_ms": { "maxItems": 0 }
                    }
                  },
                  {
                    "properties": {
                      "status_codes": { "minItems": 1 },
                      "delays_ms": { "minItems": 1 }
                    }
                  }
                ]
              },
              "model_routes": {
                "type": "object",
                "propertyNames": { "type": "string", "pattern": "\\S" },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "model": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  },
                  "required": ["model"],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "type",
              "id",
              "base_url",
              "credentials",
              "models",
              "disabled",
              "priority"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "api_keys": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "api_key": { "type": "string", "minLength": 1 },
          "providers": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 256 },
            "uniqueItems": true
          },
          "model_routes": {
            "type": "object",
            "propertyNames": { "type": "string", "pattern": "\\S" },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "model": { "type": "string", "minLength": 1, "maxLength": 256 },
                "providers": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "uniqueItems": true
                }
              },
              "required": ["model"],
              "additionalProperties": false
            }
          }
        },
        "required": ["id", "api_key", "providers"],
        "additionalProperties": false
      }
    },
    "model_routes": {
      "type": "object",
      "propertyNames": { "type": "string", "pattern": "\\S" },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "model": { "type": "string", "minLength": 1, "maxLength": 256 },
          "providers": {
            "minItems": 1,
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 256 },
            "uniqueItems": true
          }
        },
        "required": ["model"],
        "additionalProperties": false
      }
    },
    "web_search": {
      "oneOf": [
        {
          "type": "object",
          "properties": { "mode": { "type": "string", "const": "proxy" } },
          "required": ["mode"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": { "type": "string", "const": "tavily" },
            "api_key": { "type": "string", "minLength": 1 },
            "base_url": { "type": "string", "pattern": "^https?:\\/\\/" },
            "max_results": {
              "default": 5,
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            }
          },
          "required": ["mode", "api_key"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": { "type": "string", "const": "exa" },
            "api_key": { "type": "string", "minLength": 1 },
            "base_url": { "type": "string", "pattern": "^https?:\\/\\/" },
            "max_results": {
              "default": 10,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "required": ["mode", "api_key"],
          "additionalProperties": false
        }
      ]
    },
    "model_policies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "provider_id": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 },
          "context_window": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "pricing": {
            "type": "object",
            "properties": {
              "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
              "tiers": {
                "minItems": 1,
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "up_to_input_tokens": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        { "type": "null" }
                      ]
                    },
                    "input": {
                      "type": "string",
                      "pattern": "^(?:0|[1-9]\\d{0,6})(?:\\.\\d{1,6})?$"
                    },
                    "output": {
                      "type": "string",
                      "pattern": "^(?:0|[1-9]\\d{0,6})(?:\\.\\d{1,6})?$"
                    },
                    "cache_write": {
                      "type": "string",
                      "pattern": "^(?:0|[1-9]\\d{0,6})(?:\\.\\d{1,6})?$"
                    },
                    "cache_read": {
                      "type": "string",
                      "pattern": "^(?:0|[1-9]\\d{0,6})(?:\\.\\d{1,6})?$"
                    },
                    "cache_write_5m": {
                      "type": "string",
                      "pattern": "^(?:0|[1-9]\\d{0,6})(?:\\.\\d{1,6})?$"
                    },
                    "cache_write_1h": {
                      "type": "string",
                      "pattern": "^(?:0|[1-9]\\d{0,6})(?:\\.\\d{1,6})?$"
                    }
                  },
                  "required": [
                    "up_to_input_tokens",
                    "input",
                    "output",
                    "cache_write",
                    "cache_read"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": ["currency", "tiers"],
            "additionalProperties": false
          }
        },
        "required": ["provider_id", "model"],
        "additionalProperties": false
      }
    },
    "reporting": {
      "type": "object",
      "properties": {
        "time_zone": { "type": "string", "minLength": 1 },
        "retention_days": { "type": "integer", "minimum": 100, "maximum": 730 }
      },
      "required": ["time_zone", "retention_days"],
      "additionalProperties": false
    },
    "revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": ["providers", "api_keys"],
  "additionalProperties": false
}
