{
  "name": "cody",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:cloudflare": "node scripts/setup-local.mjs && concurrently --kill-others --names gateway,console \"wrangler dev --local --assets console/public\" \"npm run dev:console\"",
    "build:cloudflare": "npm run build:console && wrangler deploy --dry-run",
    "deploy:cloudflare": "npm run build:console && node scripts/deploy.mjs",
    "types:cloudflare": "wrangler types --include-runtime=false --strict-vars=false",
    "dev:node": "concurrently --kill-others --names gateway,console \"node --env-file-if-exists=.env --import tsx --watch src/server.ts\" \"npm run dev:console\"",
    "build:node": "npm run build:console && node scripts/build-standard.mjs node",
    "start:node": "node --env-file-if-exists=.env dist/server.mjs",
    "deploy:node": "npm run build:node && npm run db:migrate",
    "build:vercel": "npm run build:console && node scripts/build-standard.mjs vercel",
    "deploy:vercel": "npm run build:vercel && npm run db:migrate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/migrate.ts",
    "dev:console": "npm run dev --workspace @cody/console",
    "build:console": "npm run build --workspace @cody/console",
    "test": "npm run test:unit && npm run test:worker",
    "test:unit": "node --import tsx --test tests/*.test.mjs",
    "pretest:worker": "npm run build:console",
    "test:worker": "vitest run",
    "test:e2e": "npm run test:e2e --workspace @cody/console --",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @cody/console",
    "lint": "oxlint --deny-warnings . && npm run lint:types",
    "lint:types": "oxlint --type-aware --deny-warnings src console/src",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "models:sync": "node scripts/generate-models.mjs",
    "data:transfer": "node --env-file-if-exists=.env --import tsx scripts/transfer-data.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.9",
    "@cloudflare/workers-types": "^5.20261028.1",
    "@electric-sql/pglite": "^0.5.12",
    "@types/node": "24.19.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "@js-temporal/polyfill": "^0.5.1",
    "@libsql/client": "^0.18.0",
    "@peculiar/x509": "3.1.0",
    "@reclaimprotocol/tls": "0.1.5",
    "@vercel/functions": "^3.10.4",
    "gpt-tokenizer": "^4.1.0",
    "hono": "^4.13.14",
    "ioredis": "^6.0.0",
    "jose": "^6.2.13",
    "pg": "^8.23.1",
    "websocket-driver": "0.7.5",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "workspaces": [
    "console"
  ],
  "overrides": {
    "sharp": "0.35.5"
  }
}
